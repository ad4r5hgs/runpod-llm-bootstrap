# Tested target: NVIDIA A40 48 GB, Linux x86_64, CUDA 12.8-compatible llama.cpp binary.
# Copy to config.env and edit as needed.

# Prebuilt provider. This is a binary package, not a container image. The
# package was manually validated on an A40 before being selected here.
LLAMA_CPP_PROVIDER="ai-dock/llama.cpp-cuda"
LLAMA_CPP_TAG="b10182"
LLAMA_CPP_EXPECTED_COMMIT="afeebe1"
LLAMA_CPP_CUDA="12.8"
LLAMA_CPP_ASSET_NAME="llama.cpp-b10182-cuda-12.8-amd64.tar.gz"

# Hardware policy. A40 is the validated target; set REQUIRE_A40=false to permit
# another NVIDIA GPU, provided it has enough VRAM and a working CUDA backend.
REQUIRE_A40="true"
MIN_VRAM_GIB="40"

# Hugging Face repository and exact files that were tested.
MODEL_REPO="philbert440/Qwen3.8-27B-Uncensored-Aggressive-GGUF"
MODEL_REVISION="main"
MODEL_FILE="Qwen3.8-27B-Uncensored-Balanced-Q8_0.gguf"
MTP_FILE="mtp-Qwen3.8-27B-Uncensored-Balanced-Q8_0.gguf"
HF_MAX_WORKERS="8"
HF_TOKEN=""

# Long-context throughput experiment. Qwen3.8-27B's native context is 262,144
# tokens. This asks llama.cpp to allocate the full KV cache; it is intentionally
# aggressive on a 48 GB GPU and may fail if the model/runtime does not fit.
CONTEXT_SIZE="262144"
GPU_LAYERS="999"
MTP_GPU_LAYERS="999"
# Start with the best documented MTP depth for local Qwen3.8 GGUF testing.
# Validated winner on A40 at 262K (Sep 2026 sweeps + 48.9 t/s lock-in):
# N_MAX 4 beat 1/2/3 and smart 16+0.8 on q8_0 KV. MTP off was ~19.5 t/s.
MTP_DRAFT_N_MAX="4"
# Optional helper smart-stop (Step 1 tuning). Empty = flag omitted, which keeps
# older builds such as b10182 working. Example smart mode: "0.8" with N_MAX 16.
# If set, the binary must list --spec-draft-p-min in --help.
MTP_DRAFT_P_MIN=""
# Keep the full context for one active request. The server-wide context budget
# is shared among parallel slots, so raising this reduces per-request context.
SERVER_PARALLEL="1"
# Quantized KV cache is necessary to make a 262K allocation plausible on 48 GB.
# Validated winner on A40 at 262K: q8_0/q8_0 with Flash Attention on.
# It fit alongside Q8 weights + MTP head and gave the top 48.9 t/s run.
# Quantized V cache requires Flash Attention in llama.cpp.
FLASH_ATTN="on"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
# These affect prompt/prefill throughput, not single-token decode speed.
BATCH_SIZE="2048"
UBATCH_SIZE="512"
# b10182 supports --reasoning on|off|auto and --reasoning-budget. It does not
# support the newer --reasoning-effort medium preset.
# Disable visible reasoning for the maximum-throughput experiment. Re-enable it
# after measuring quality on representative coding tasks.
REASONING_MODE="off"
REASONING_BUDGET=""

# Storage / paths.
INSTALL_DIR="/opt/qwen-runpod"
MODEL_DIR="/models"
LLAMA_DIR="${INSTALL_DIR}/llama.cpp"
MIN_FREE_DISK_GIB="40"

# This allocation smoke test proves the selected full-context configuration can
# initialise. It uses a tiny prompt/output, but still allocates the full KV cache.
SMOKE_CTX_SIZE="262144"
SMOKE_N_PREDICT="8"
SMOKE_PROMPT="Answer in one short sentence: what is the capital of Australia?"

# test-xhigh-thinking.sh settings. The pinned b10182 llama.cpp build has no
# named --reasoning-effort selector; the script uses reasoning-on plus this
# large numeric budget, which leaves room for the requested final answer.
TEST_TARGET_WORDS="120"
TEST_REASONING_BUDGET="32000"
TEST_N_PREDICT="32768"
# TEST_PROMPT=""

# Step 1 + Step 2 sweep (bench-mtp-sweep.sh). Plain-language recap:
# Step 1 = helper guessing depth (N_MAX 1,2,3,4 plus smart 16+0.8).
# Step 2 = scratch-paper size (KV cache pairs to compare).
SWEEP_N_MAX_LIST="1 2 3 4"
SWEEP_EXTRA_N_MAX="16"
SWEEP_EXTRA_P_MIN="0.8"
SWEEP_KV_PAIRS="q4_0:q4_0 q8_0:q8_0"
SWEEP_N_PREDICT="128"
# SWEEP_PROMPT=""

# Server defaults. run-server.sh always binds 0.0.0.0 so the RunPod HTTP proxy
# and coding harnesses can reach it; LLAMA_API_KEY is therefore required.
# Keep the key private and never commit config.env.
SERVER_HOST="0.0.0.0"
SERVER_PORT="8080"
SERVER_MODEL_ID="qwen3.8-27b-philbert"
LLAMA_API_KEY=""

# Optional: download the vision projector for multimodal/image inference.
DOWNLOAD_VISION_PROJECTOR="false"
VISION_FILE="mmproj-Qwen3.8-27B-Uncensored-Balanced-F16.gguf"
